);
uint turbo4_find_nearest(float val) {
    if (val < turbo4_midpoints_q[7]) {
        if (val < turbo4_midpoints_q[3]) {
            if (val < turbo4_midpoints_q[1]) {
                return val < turbo4_midpoints_q[0] ? 0u : 1u;
            } else {
                return val < turbo4_midpoints_q[2] ? 2u : 3u;
            }
        } else {
            if (val < turbo4_midpoints_q[5]) {
                return val < turbo4_midpoints_q[4] ? 4u : 5u;
            } else {
                return val < turbo4_midpoints_q[6] ? 6u : 7u;
            }
        }
    } else {
        if (val < turbo4_midpoints_q[11]) {
            if (val < turbo4_midpoints_q[9]) {
                return val < turbo4_midpoints_q[8] ? 8u : 9u;
            } else {
                return val < turbo4_midpoints_q[10] ? 10u : 11u;
            }
        } else {
            if (val < turbo4_midpoints_q[13]) {
                return val < turbo4_midpoints_q[12] ? 12u : 13u;
            } else {
                return val < turbo4_midpoints_q[14] ? 14u : 15u;
            }
        }
    }
}
void turbo4_fwht_128(inout float x[128]) {
    for (int h = 1; h < 128; h *= 2) {
        for (int i = 0; i < 128; i += h * 2) {
            for (int j = i; j < i + h; j++) {
                float a = x[j], b = x[j + h];
                x[j] = a + b; x[j + h] = a - b;
            }
        }
    }
    const float inv_sqrt_128 = 0.08838834764831845;
    for (int i = 0; i < 128; i++) x[i] *= inv_sqrt_128;
}
void quantize(uint dst_idx, uint src_idx) {
    float norm_sq = 0.0;
    for (int j = 0; j < QUANT_K_TURBO4_0; ++j) {
        const float v = data_s[src_idx + j];
        norm_sq += v * v;
    }
    float norm = sqrt(norm_sq);
    float inv_norm = norm > 1e-10 ? 1.0 / norm : 0.0;
    float x[128];
    for (int j = 0; j < 128; j++) x[j] = data_s[src_idx + j] * inv_norm;
    for (int j = 0; j < 128; j++) x[j] *= turbo4_wht_signs1[j];
    turbo4_fwht_128(x);
    for (int j = 0; j < 128; j++) x[j] *= turbo4_wht_signs2[j];
    uint8_t packed[64];
    float recon_sq = 0.0;
    for (int j = 0; j < 128; j += 2) {
        uint idx0 = turbo4_find_nearest(x[j]);
        uint idx1 = turbo4_find_nearest(x[j + 1]);
        packed[j / 2] = uint8_t((idx1 << 4) | idx0);
        float r0 = turbo4_centroids_q[idx0];
        float r1 = turbo4_centroids_q[idx1];
        recon_sq += r0 * r0 + r1 * r1;
    }
    for (int j = 0; j < 64; j++) data_q[dst_idx].qs[j] = packed[j];
    float recon_norm = sqrt(recon_sq);
    float corrected = (recon_norm > 1e-10) ? norm / recon_norm : norm;
    data_q[dst_idx].d = float16_t(corrected);
}
